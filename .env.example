# Native backend: copy only when backend/.env does not already exist.
# Fresh Compose stack: use scripts/init-compose-env.py instead; it never overwrites
# existing secrets. Keep populated environment files private and out of Git.
APP_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=agentshield_ai
MONGODB_MAX_POOL_SIZE=10
MONGODB_TIMEOUT_MS=3000
# Required: generate a random key (at least 32 bytes). Empty deliberately fails.
JWT_SECRET=
# Optional separate stable key (same strength as JWT_SECRET). Otherwise derived
# from JWT_SECRET; rotating that key then invalidates signed audit history.
AUDIT_SIGNING_KEY=
JWT_ISSUER=agentshield-api
JWT_AUDIENCE=agentshield-web
ACCESS_TOKEN_MINUTES=15
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
LOGIN_EMAIL_LIMIT=5
LOGIN_IP_LIMIT=30
REGISTER_IP_LIMIT=10
RATE_WINDOW_SECONDS=300
# Optional frontend/.env.local settings (not secrets):
# API_INTERNAL_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_API_URL=

# Phase 3: server-only provider configuration. Never put API keys in NEXT_PUBLIC_*.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_ENABLED=false
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_URL=http://127.0.0.1:11434
AGENT_PROVIDER_TIMEOUT=15
AGENT_REQUEST_TIMEOUT=45
AGENT_MAX_ITERATIONS=4
AGENT_MAX_TOOL_CALLS=3
AGENT_USER_LIMIT=10

# Phase 4: disabled until effective isolation has been verified. Server-only.
SANDBOX_ENABLED=false
SANDBOX_POLICY=approval
SANDBOX_DOCKER_URL=unix:///var/run/docker.sock
SANDBOX_MEMORY_MB=128
SANDBOX_CPUS=1
SANDBOX_PIDS=32
SANDBOX_TIMEOUT=10
SANDBOX_OUTPUT_BYTES=65536
SANDBOX_CODE_BYTES=32768
SANDBOX_RETENTION_DAYS=7
SANDBOX_APPROVAL_SECONDS=300
SANDBOX_USER_LIMIT=5

# Phase 5: bounded metadata-only monitoring. No sandbox controls are changed.
MONITOR_POLL_SECONDS=1
MONITOR_SEND_TIMEOUT=3
MONITOR_HEARTBEAT_SECONDS=15
# Must exceed heartbeat + polling interval.
MONITOR_PONG_SECONDS=35

# Compose only: use the exclusive-create helper to generate these URL-safe values.
# Never point the MongoDB 7 service at an existing MongoDB 8 data directory/volume.
MONGO_APP_USER=agentshield_app
MONGO_APP_PASSWORD=
MONGO_ROOT_PASSWORD=
FRONTEND_PORT=3000
