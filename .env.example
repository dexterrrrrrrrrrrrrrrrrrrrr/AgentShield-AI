# Copy this example to backend/.env. Never commit the populated file.
APP_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=agentshield_ai
MONGODB_MAX_POOL_SIZE=10
MONGODB_TIMEOUT_MS=3000
# Required: generate a random key (at least 32 bytes). Empty deliberately fails.
JWT_SECRET=
JWT_ISSUER=agentshield-api
JWT_AUDIENCE=agentshield-web
ACCESS_TOKEN_MINUTES=15
CORS_ORIGINS=http://localhost:3000
LOGIN_EMAIL_LIMIT=5
LOGIN_IP_LIMIT=30
REGISTER_IP_LIMIT=10
RATE_WINDOW_SECONDS=300
# Optional frontend/.env.local settings (not secrets):
# API_INTERNAL_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_API_URL=
